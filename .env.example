# SOFIX: every setting of compose.yaml, with its default. Copy to .env and change what you need:
#   cp .env.example .env
# Lines left commented out keep the default. docs/deployment/docker.md explains each setting.
# Never commit .env: it holds passwords.

# ---------------------------------------------------------------------------------------------
# Stack
# ---------------------------------------------------------------------------------------------
# Which side this stack serves: SELL_SIDE (a broker answering client orders) or BUY_SIDE
# (companies sending orders to brokers). Passed to the OEMS and the backend; the app shows
# that side's panels. Run a second stack for the other side.
#DEPLOYMENT_MODE=SELL_SIDE
# Name of this stack (container, network and default volume names start with it).
#COMPOSE_PROJECT_NAME=sofix
# Restart policy of the long-running services: no | always | unless-stopped | on-failure
#RESTART_POLICY=unless-stopped
# Docker's own log rotation for each container's stdout.
#DOCKER_LOG_MAX_SIZE=20m
#DOCKER_LOG_MAX_FILES=5
# Time zone of every container (logs, the OEMS's trading day later).
#TZ=UTC
# Image names: <IMAGE_PREFIX>/oems:<IMAGE_TAG>, …/ui-be, …/ui-fe (for pushing to a registry).
#IMAGE_PREFIX=sofix
#IMAGE_TAG=local

# ---------------------------------------------------------------------------------------------
# How users reach SOFIX
# ---------------------------------------------------------------------------------------------
# The address users type in the browser: the server's IP or name and the UI port, e.g.
# http://10.20.30.40:8080 or https://sofix.example.com. Used for sign-in redirects (SSO).
#PUBLIC_URL=http://localhost:8080
# Where the app (ui) listens on the host. 0.0.0.0 = every network interface (reachable from
# other machines); 127.0.0.1 = this machine only.
#UI_BIND=0.0.0.0
#UI_HOST_PORT=8080
# Largest upload through the app (broker specification PDFs; the backend accepts up to 20 MB).
#UI_MAX_UPLOAD_SIZE=25m
# How long the app's proxy waits for a backend answer (streamed spec conversion included).
#UI_PROXY_TIMEOUT=300s
# Where the browser sends API calls and opens the event stream. Relative (default) = through
# the app's own address, which proxies to the backend. Set absolute URLs only when the
# backend is published separately, e.g. http://10.20.30.40:8090/api and ws://10.20.30.40:8090/ws.
#SOFIX_API_URL=/api
#SOFIX_WS_URL=/ws
# Where the app's proxy finds the backend (another host: http://10.20.30.41:8090).
#BACKEND_UPSTREAM=http://backend:8090

# ---------------------------------------------------------------------------------------------
# Backend (sofix-ui-be)
# ---------------------------------------------------------------------------------------------
# Published port of the backend (ng serve during UI development talks to it). 127.0.0.1 keeps
# it on this machine; the Docker app does not need it published.
#BACKEND_BIND=127.0.0.1
#BACKEND_HOST_PORT=8090
# Where the backend finds the OEMS (an OEMS on the host while developing it:
# http://host.docker.internal:8095).
#OEMS_URL=http://oems:8095
# CORS: the origin allowed to call the backend directly. * echoes any origin; set the app's
# address in production when the backend is published (e.g. http://10.20.30.40:8080).
#ALLOWED_ORIGIN=*
# Password of the first administrator (operator), used only while nobody has a password yet.
# Locked out later: docker compose exec backend node src/set-password.js operator
#INITIAL_ADMIN_PASSWORD=sofix-admin
# How long a sign-in lasts.
#SESSION_HOURS=12
# 1 enables POST /api/test/reset (e2e tests only). Keep 0.
#ENABLE_TEST_API=0
# SSO (OpenID Connect). Off unless the first three are set.
#OIDC_ISSUER=
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_PROVIDER_NAME=SSO
# Default: ${PUBLIC_URL}/api/auth/sso/callback (register it at the provider).
#OIDC_REDIRECT_URI=
#OIDC_SCOPES=openid email profile

# ---------------------------------------------------------------------------------------------
# FIX OEMS (sofix-oems)
# ---------------------------------------------------------------------------------------------
# Published port of the OEMS REST API and Actuator (health, Prometheus). The browser never
# calls it.
#OEMS_BIND=127.0.0.1
#OEMS_HOST_PORT=8095
# FIX acceptor ports: an acceptor session must listen on a port in this range (container and
# host use the same numbers). FIX_BIND=0.0.0.0 lets counterparties on other machines connect.
#FIX_BIND=0.0.0.0
#FIX_PORT_RANGE=9870-9899
# Key for the SSL passwords the OEMS stores (Base64 AES-256: openssl rand -base64 32).
# Empty = the built-in development key (a warning is logged). Set it on a server, once:
# changing it makes stored SSL passwords unreadable.
#OEMS_SECRET_KEY=
# JVM options, e.g. -Xmx2g. Default: up to 75 % of the container's memory.
#OEMS_JAVA_OPTS=-XX:MaxRAMPercentage=75
# Where the OEMS log files go on the host (oems-app.log, oems-audit.log, per session…).
#OEMS_LOGS=./logs/oems
# Simulated pace of the certification endpoints (0ms = instant).
#OEMS_CERTIFICATION_CHUNK_DELAY=900ms
#OEMS_CERTIFICATION_TEST_CASES_DELAY=1500ms
# Extension points: where specifications come from; how Message Details describes FIX messages.
#OEMS_SPECIFICATION_CATALOG=classpath
#OEMS_FIX_DICTIONARY=qfj
# Volume of the QuickFIX/J stores (sequence numbers, uploaded dictionaries).
#OEMS_FIX_DATA_VOLUME=sofix_oems-fix-data

# ---------------------------------------------------------------------------------------------
# PostgreSQL: one server, two databases
# ---------------------------------------------------------------------------------------------
#POSTGRES_VERSION=17
# The server's administrator (creates the databases and users at each start, see db-init).
#POSTGRES_SUPERUSER=sofix
#POSTGRES_SUPERUSER_PASSWORD=sofix
# Published port of the server (database tools, ng serve setups). 127.0.0.1 = this machine.
#POSTGRES_BIND=127.0.0.1
#POSTGRES_HOST_PORT=5433
# Volume holding the data. The default is the one the earlier setup used, so data carries over.
#POSTGRES_VOLUME=sofix-mock-backend_postgres-data

# The backend's database. UI_DB_HOST/PORT: another server instead of the one above (then
# create the database and user there yourself; see the docs).
#UI_DB_NAME=sofix
#UI_DB_USER=sofix
#UI_DB_PASSWORD=sofix
#UI_DB_HOST=postgres
#UI_DB_PORT=5432
# Extra connection parameters, appended as is, e.g. ?sslmode=require
#UI_DB_URL_PARAMS=

# The OEMS's database.
#OEMS_DB_NAME=oems
#OEMS_DB_USER=oems
#OEMS_DB_PASSWORD=oems
#OEMS_DB_HOST=postgres
#OEMS_DB_PORT=5432
# Extra JDBC parameters, appended as is, e.g. ?sslmode=require
#OEMS_DB_URL_PARAMS=

# Where db-init creates the databases and users (the server above by default).
#DB_INIT_HOST=postgres
#DB_INIT_PORT=5432
